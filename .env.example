# Configuration des clés API RapidAPI
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Clé API RapidAPI pour accéder à l'API de mail temporaire
RAPIDAPI_KEY=votre-clé-api-ici

# Hôte de l'API RapidAPI (par défaut: privatix-temp-mail-v1.p.rapidapi.com)
RAPIDAPI_HOST=privatix-temp-mail-v1.p.rapidapi.com

# Configuration pour la génération de QR codes App (Basic Fit)
# Note: Numéro de carte pour les QR codes app (utilisé en dur dans le code)
QR_CARD_NUMBER=V00347833
